# Backend (FastAPI) base URL and WebSocket base URL
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
# true = run fully offline with the built-in mock adapter (no backend needed)
VITE_USE_MOCKS=false
# true = presenter shortcuts on /stage, demo trigger buttons, demo tokens
VITE_DEMO_MODE=true
