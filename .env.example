# Saarthi Application Settings
APP_NAME=Saarthi
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
DEMO_MODE=true

# Database (Default: local SQLite database file, portable to PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:///./saarthi.db

# Global Autonomy / Guardian Settings
KILL_SWITCH_ACTIVE=false
FINANCIAL_IMPACT_THRESHOLD_INR=5000.0
AUTO_RESOLVE_CONFIDENCE_THRESHOLD=0.85
CLARIFY_CONFIDENCE_THRESHOLD=0.60

# Security & Authentication (Phase 7: Fintech Hardening)
JWT_SECRET_KEY=saarthi_dev_insecure_jwt_secret_key_change_in_prod_32chars!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
RATE_LIMIT_PER_MINUTE=60
CHAT_RATE_LIMIT_PER_MINUTE=20
MAX_AUDIO_SIZE_BYTES=5242880

# LLM Providers (MockLLM is used by default if keys are unset or DEMO_MODE=true)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Speech-to-Text (STT) Providers (Sarvam AI primary, faster-whisper / audio fallback)
STT_PROVIDER=sarvam
SARVAM_API_KEY=

# Text-to-Speech (TTS) Providers (Sarvam AI / edge-tts / pre-recorded audio fallback)
TTS_PROVIDER=edge-tts

# Travel / Flights API (SeededFlightsProvider used by default, Amadeus optional test mode)
FLIGHTS_PROVIDER=seeded
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# Payments Sandbox (MockPaymentLink by default, Paytm / Razorpay test mode optional)
PAYMENTS_PROVIDER=mock
PAYTM_MID=
PAYTM_MERCHANT_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# External Notification (In-App / WebSocket by default; Twilio WhatsApp optional)
NOTIFY_PROVIDER=in_app
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
